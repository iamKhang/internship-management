@model GvRegistrationsPageVm
@{
    ViewData["Title"] = "Sinh viên đăng ký đề tài";
}

<style>
    .action-cell {
        min-height: 80px;
        vertical-align: middle;
        width: 140px;
    }

    .action-cell .badge {
        font-size: 0.75rem;
        padding: 0.375rem 0.5rem;
    }
</style>
<div class="card shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Sinh viên đăng ký đề tài</h5>
        <div class="small text-muted">Tổng: <strong>@Model.Items.Count</strong></div>
    </div>

    <div class="card-body">

        <form method="get" class="row g-3 align-items-end mb-3" id="filterForm">
            <div class="col-md-4">
                <label class="form-label">Học kỳ/Năm học</label>
                <div class="searchable-dropdown" id="termDropdownReg">
                    <input type="hidden"
                        value="@(Model.Filter.HocKy.HasValue && !string.IsNullOrEmpty(Model.Filter.NamHoc) ? ($"{Model.Filter.HocKy}|{Model.Filter.NamHoc}") : "")" />
                    <input type="text" class="form-control" autocomplete="off">
                    <i class="bi bi-chevron-down dropdown-arrow"></i>
                    <div class="dropdown-menu">
                        <div class="dropdown-options">
                            <a class="dropdown-item" href="#" data-value="">-- Tất cả --</a>
                        </div>
                    </div>
                </div>
                <input type="hidden" name="hocKy" value="@(Model.Filter.HocKy?.ToString() ?? "")" />
                <input type="hidden" name="namHoc" value="@(Model.Filter.NamHoc ?? "")" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Đề tài</label>
                <div class="searchable-dropdown" id="deTaiDropdownReg">
                    <input type="hidden" name="maDt" value="@Model.Filter.MaDt" />
                    <input type="text" class="form-control" placeholder="Tìm kiếm đề tài..." autocomplete="off">
                    <i class="bi bi-chevron-down dropdown-arrow"></i>
                    <div class="dropdown-menu">
                        <div class="dropdown-options">
                            <!-- Options will be loaded dynamically -->
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label">Trạng thái</label>
                <div class="searchable-dropdown" id="statusDropdownReg">
                    <input type="hidden" name="trangThai" value="@(Model.Filter.TrangThai?.ToString() ?? "")" />
                    <input type="text" class="form-control" autocomplete="off">
                    <i class="bi bi-chevron-down dropdown-arrow"></i>
                    <div class="dropdown-menu">
                        <div class="dropdown-options">
                            <a class="dropdown-item" href="#" data-value="">-- Tất cả --</a>
                            <a class="dropdown-item" href="#" data-value="0">Đang chờ duyệt</a>
                            <a class="dropdown-item" href="#" data-value="1">Chấp nhận</a>
                            <a class="dropdown-item" href="#" data-value="2">Đang thực hiện</a>
                            <a class="dropdown-item" href="#" data-value="3">Hoàn thành</a>
                            <a class="dropdown-item" href="#" data-value="4">Đã từ chối</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 d-flex gap-2 justify-content-end">
                <a class="btn btn-outline-secondary py-2" asp-action="Registrations">
                    <i class="bi bi-arrow-clockwise me-1"></i>Hủy
                </a>
                <a class="btn btn-success py-2" asp-action="ExportRegistrationsExcel"
                    asp-route-hocKy="@(Model.Filter.HocKy)" asp-route-namHoc="@(Model.Filter.NamHoc)"
                    asp-route-trangThai="@(Model.Filter.TrangThai)" asp-route-maDt="@(Model.Filter.MaDt)">
                    <i class="bi bi-file-earmark-excel me-1"></i>Excel
                </a>
                <button class="btn btn-primary py-2" type="submit" id="btnFilter">
                    <i class="bi bi-funnel me-1"></i>Lọc
                </button>
            </div>
        </form>

        <div class="grid-responsive">
            <div class="grid-container">
                <ejs-grid id="RegistrationsGrid" dataSource="@Model.Items" allowPaging="true" allowSorting="false"
                    allowMultiSorting="false" allowFiltering="false" allowResizing="true" gridLines="Both" height="600"
                    width="100%" grid-lines="Both" enable-hover="false" enable-alt-row="true">
                    <e-grid-pagesettings pageSize="20"
                        pageSizes="new List<int>{10,20,50,100,500}"></e-grid-pagesettings>
                    <e-grid-columns>
                        <e-grid-column field="Stt" headerText="STT" width="60" textAlign="Center"></e-grid-column>
                        <e-grid-column field="NgayDangKy" headerText="Ngày đăng ký" width="130" type="date"
                            format="dd/MM/yyyy"></e-grid-column>
                        <e-grid-column field="HotenSv" headerText="Sinh viên" width="220"></e-grid-column>
                        <e-grid-column field="Sv_TenKhoa" headerText="Khoa" width="180"></e-grid-column>
                        <e-grid-column field="MaDt" headerText="Mã ĐT" width="120"></e-grid-column>
                        <e-grid-column field="TenDt" headerText="Tên đề tài" width="300"></e-grid-column>
                        <e-grid-column field="HocKyNamHoc" headerText="Học kỳ" width="140"
                            textAlign="Center"></e-grid-column>
                        <e-grid-column headerText="Trạng thái" width="140" textAlign="Center"
                            template="#trangThaiTemplate"></e-grid-column>
                        <e-grid-column field="KetQua" headerText="Kết quả" width="100"
                            textAlign="Center"></e-grid-column>
                        <e-grid-column headerText="Thao tác" width="180" textAlign="Center"
                            template="#actionTemplate"></e-grid-column>
                    </e-grid-columns>
                </ejs-grid>
            </div>
        </div>

        <script id="sinhVienTemplate" type="text/x-template">
            <div class="fw-semibold">${HotenSv} (#${Masv})</div>
            <div class="text-muted small">${Sv_TenKhoa} (${Sv_MaKhoa})</div>
            ${if(QueQuan)}<div class="text-muted small">QQ: ${QueQuan}</div>${/if}
        </script>
        <script id="deTaiTemplate" type="text/x-template">
            <div class="fw-semibold">${TenDt}</div>
            <div class="text-muted small">Mã: <span class="text-monospace">${MaDt}</span></div>
        </script>
        <script id="hocKyTemplate" type="text/x-template">
            ${HocKy} - ${NamHoc}
        </script>
        <script id="trangThaiTemplate" type="text/x-template">
            ${if(TrangThai==0)}<span class="badge bg-warning text-dark">Đang chờ duyệt</span>${/if}
            ${if(TrangThai==1)}<span class="badge bg-success text-white">Chấp nhận</span>${/if}
            ${if(TrangThai==2)}<span class="badge bg-info text-white">Đang thực hiện</span>${/if}
            ${if(TrangThai==3)}<span class="badge bg-success text-white">Hoàn thành</span>${/if}
            ${if(TrangThai==4)}<span class="badge bg-danger text-white">Đã từ chối</span>${/if}
            ${if(TrangThai==5)}<span class="badge bg-secondary text-white">Đã rút</span>${/if}
            ${if(TrangThai!=0 && TrangThai!=1 && TrangThai!=2 && TrangThai!=3 && TrangThai!=4 && TrangThai!=5)}<span class="badge bg-secondary text-white">Khác</span>${/if}
        </script>
        <script id="ketQuaTemplate" type="text/x-template">
            ${if(KetQua==null)}<span class="text-muted">-</span>${/if}
            ${if(KetQua!=null)}<span class="fw-semibold">${KetQua}</span>${/if}
        </script>
        <script id="actionTemplate" type="text/x-template">
            ${if(TrangThai==0)}
                <div class="d-flex gap-2 justify-content-center" id="action-${Masv}-${MaDt}">
                    <button type="button" class="btn btn-primary btn-sm w-100 btn-approve" data-masv="${Masv}" data-madt="${MaDt}"><i class="bi bi-check-circle me-1"></i>Duyệt</button>
                    <button type="button" class="btn btn-danger btn-sm w-100 btn-reject" data-masv="${Masv}" data-madt="${MaDt}"><i class="bi bi-x-circle me-1"></i>Từ chối</button>
                </div>
            ${/if}
            ${if(TrangThai==1)}
                <button type="button" class="btn btn-outline-primary btn-sm btn-start" data-masv="${Masv}" data-madt="${MaDt}"><i class="bi bi-play-circle me-1"></i>Bắt đầu</button>
            ${/if}
            ${if(TrangThai==2)}
                <button type="button" class="btn btn-success btn-sm btn-complete" data-masv="${Masv}" data-madt="${MaDt}" data-hoten="${HotenSv}" data-tendt="${TenDt}"><i class="bi bi-flag-checkered me-1"></i>Hoàn thành</button>
            ${/if}
            ${if(TrangThai!=0 && TrangThai!=1 && TrangThai!=2)}<span class="text-muted">—</span>${/if}
        </script>

        <form id="frmApprove" method="post" asp-action="ApproveRegistration" class="d-none">
            @Html.AntiForgeryToken()
            <input type="hidden" name="maSv" />
            <input type="hidden" name="maDt" />
            <input type="hidden" name="hocKy" value="@(Model.Filter.HocKy)" />
            <input type="hidden" name="namHoc" value="@(Model.Filter.NamHoc)" />
            <input type="hidden" name="trangThai" value="@(Model.Filter.TrangThai)" />
            <input type="hidden" name="filterMaDt" value="@(Model.Filter.MaDt)" />
        </form>
        <form id="frmReject" method="post" asp-action="RejectRegistration" class="d-none">
            @Html.AntiForgeryToken()
            <input type="hidden" name="maSv" />
            <input type="hidden" name="maDt" />
            <input type="hidden" name="hocKy" value="@(Model.Filter.HocKy)" />
            <input type="hidden" name="namHoc" value="@(Model.Filter.NamHoc)" />
            <input type="hidden" name="trangThai" value="@(Model.Filter.TrangThai)" />
            <input type="hidden" name="filterMaDt" value="@(Model.Filter.MaDt)" />
        </form>
        <form id="frmStart" method="post" asp-action="SetHuongDanInProgress" class="d-none">
            @Html.AntiForgeryToken()
            <input type="hidden" name="maSv" />
            <input type="hidden" name="maDt" />
            <input type="hidden" name="ghiChu" value="Bắt đầu thực hiện" />
            <input type="hidden" name="hocKy" value="@(Model.Filter.HocKy)" />
            <input type="hidden" name="namHoc" value="@(Model.Filter.NamHoc)" />
            <input type="hidden" name="trangThai" value="@(Model.Filter.TrangThai)" />
            <input type="hidden" name="filterMaDt" value="@(Model.Filter.MaDt)" />
        </form>

        <div class="modal fade" id="completeModalReg" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Nhập điểm hoàn thành</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form method="post" asp-action="SetHuongDanCompleted" id="frmComplete">
                        @Html.AntiForgeryToken()
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label">Sinh viên</label>
                                <div class="form-control-plaintext fw-semibold" id="cmSv"></div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Đề tài</label>
                                <div class="form-control-plaintext" id="cmDt"></div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="cmKetQua">Điểm (0–10)</label>
                                <input type="number" step="0.01" min="0" max="10" class="form-control" id="cmKetQua"
                                    name="ketQua" required />
                            </div>
                            <div class="mb-2">
                                <label class="form-label" for="cmGhiChu">Ghi chú</label>
                                <input type="text" class="form-control" id="cmGhiChu" name="ghiChu" />
                            </div>
                            <input type="hidden" name="maSv" id="cmMaSv" />
                            <input type="hidden" name="maDt" id="cmMaDt" />
                            <input type="hidden" name="hocKy" value="@(Model.Filter.HocKy)" />
                            <input type="hidden" name="namHoc" value="@(Model.Filter.NamHoc)" />
                            <input type="hidden" name="trangThai" value="@(Model.Filter.TrangThai)" />
                            <input type="hidden" name="filterMaDt" value="@(Model.Filter.MaDt)" />
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-check2-circle me-1"></i>Xác nhận hoàn thành
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

    </div>
</div>

@if (TempData["Toast"] is string toast && !string.IsNullOrWhiteSpace(toast))
{
    <div class="alert alert-info mt-3">@toast</div>
}

@section Scripts {
    <link href="~/css/searchable-dropdown.css" rel="stylesheet" />
    <script src="~/js/searchable-dropdown.js"></script>
        <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Function to calculate registration end date based on HocKy and NamHoc
            function calculateRegistrationEnd(hocKy, namHoc) {
                if (!hocKy || !namHoc) return null;
                
                const yearParts = namHoc.split('-');
                if (yearParts.length !== 2) return null;
                
                const baseYear = parseInt(yearParts[0], 10);
                const today = new Date();
                let regStart, regEnd;
                
                switch (parseInt(hocKy, 10)) {
                    case 1:
                        // HK1: 5/9 -> 31/12, nằm trong năm đầu của năm học
                        regStart = new Date(baseYear, 8, 5); // Month is 0-indexed
                        break;
                    case 2:
                        // HK2: 1/1 -> 25/5, nhưng của NĂM SAU
                        regStart = new Date(baseYear + 1, 0, 1);
                        break;
                    case 3:
                        // HK3: 26/5 -> 4/9, nhưng của NĂM SAU
                        regStart = new Date(baseYear + 1, 4, 26);
                        break;
                    default:
                        return null;
                }
                
                regEnd = new Date(regStart);
                regEnd.setDate(regEnd.getDate() + 24); // Add 24 days
                
                return regEnd;
            }
            
            // Function to check if registration is expired
            function isRegistrationExpired(hocKy, namHoc) {
                const regEnd = calculateRegistrationEnd(hocKy, namHoc);
                if (!regEnd) return false;
                
                const today = new Date();
                return today > regEnd;
            }
            
            // Store the functions globally so they can be used in templates
            window.calculateRegistrationEnd = calculateRegistrationEnd;
            window.isRegistrationExpired = isRegistrationExpired;
            
            // Check and update expired registrations after grid is rendered
            setTimeout(function() {
                const gridData = @Html.Raw(Json.Serialize(Model.Items));
                gridData.forEach(item => {
                    if (item.TrangThai === 0 && isRegistrationExpired(item.HocKy, item.NamHoc)) {
                        const actionElement = document.getElementById(`action-${item.Masv}-${item.MaDt}`);
                        if (actionElement) {
                            actionElement.innerHTML = `
                                <div class="d-flex justify-content-center">
                                    <span class="badge bg-secondary text-white">
                                        <i class="bi bi-clock-history me-1"></i>Đã qua thời gian chấp nhận
                                    </span>
                                </div>
                            `;
                        }
                    }
                });
            }, 500); // Wait for grid to render
            // Function to update DeTai options based on term
            async function updateDeTaiOptions(hocKy, namHoc) {
                try {
                    const url = '@Url.Action("GetTopicsByTerm", "DeTai")';
                    const params = new URLSearchParams();
                    if (hocKy) params.append('hocKy', hocKy);
                    if (namHoc) params.append('namHoc', namHoc);

                    const response = await fetch(`${url}?${params}`);
                    const result = await response.json();

                    if (result.success) {
                        // Use SearchableDropdown's updateOptions method instead of manual DOM manipulation
                        const deTaiEl = document.getElementById('deTaiDropdownReg');
                        const deTaiDd = deTaiEl.searchableDropdownInstance;

                        if (deTaiDd) {
                            // Clear existing options first to prevent duplicates
                            const optionsContainer = deTaiEl.querySelector('.dropdown-options');
                            optionsContainer.innerHTML = '';

                            // Update options using SearchableDropdown's method (preserves event handlers)
                            await deTaiDd.updateOptions(result.data);

                            // Setup search function for new options
                            deTaiDd.searchData = async function (query) {
                                const q = (query || '').toLowerCase();
                                const filtered = result.data.filter(o => !q || o.text.toLowerCase().includes(q));
                                await deTaiDd.updateOptions(filtered);
                            };

                            // Preserve existing DeTai selection if any
                            const deTaiInput = deTaiEl.querySelector('input.form-control');
                            const deTaiHidden = document.querySelector('input[name="maDt"]');
                            const currentMaDt = deTaiHidden?.value || '';

                            if (currentMaDt) {
                                // Try to find and maintain the selected option
                                const selectedOption = result.data.find(opt => opt.value === currentMaDt);
                                if (selectedOption && deTaiInput) {
                                    deTaiInput.value = selectedOption.text;
                                } else {
                                    // Option not found in current term, reset to "Tất cả"
                                    if (deTaiInput) deTaiInput.value = '-- Tất cả --';
                                    if (deTaiHidden) deTaiHidden.value = '';
                                }
                            } else {
                                // No selection, set to "Tất cả"
                                if (deTaiInput) deTaiInput.value = '-- Tất cả --';
                            }
                        }
                    }
                } catch (error) {
                    console.error('Error fetching topics:', error);
                }
            }

            // Term combobox (copy logic from Index.cshtml)
            const termEl = document.getElementById('termDropdownReg');
            const termDd = new SearchableDropdown('termDropdownReg', { placeholder: '', searchUrl: null, allowClear: true });
            function generateTerms(baseYear) {
                const out = [];
                for (let y = baseYear - 5; y <= baseYear; y++) {
                    const nh = `${y}-${y + 1}`;
                    for (let hk = 1; hk <= 3; hk++) out.push({ value: `${hk}|${nh}`, text: `HK${hk} (${nh})`, hk, nh });
                }
                return out;
            }
            function filterTerms(all, query) {
                if (!query) return all;
                const q = String(query).toLowerCase().replace(/\s+/g, '');
                const m = q.match(/^(\d{4})$/);
                if (m) {
                    const Y = parseInt(m[1], 10);
                    const expanded = [];
                    for (let hk = 1; hk <= 3; hk++) expanded.push({ value: `${hk}|${Y}-${Y + 1}`, text: `HK${hk} (${Y}-${Y + 1})`, hk, nh: `${Y}-${Y + 1}` });
                    for (let hk = 1; hk <= 3; hk++) expanded.push({ value: `${hk}|${Y - 1}-${Y}`, text: `HK${hk} (${Y - 1}-${Y})`, hk, nh: `${Y - 1}-${Y}` });
                    return expanded;
                }
                return all.filter(x => x.text.toLowerCase().includes(q));
            }
            const nowY = new Date().getFullYear();
            let allTerms = generateTerms(nowY).sort((a, b) => (a.nh < b.nh ? 1 : a.nh > b.nh ? -1 : b.hk - a.hk));
            termDd.searchData = async function (query) {
                const options = filterTerms(allTerms, query);
                await termDd.updateOptions(options.map(o => ({ value: o.value, text: o.text })));
            };
            termDd.searchData('');
            termEl.addEventListener('selectionChanged', function (e) {
                const val = e?.detail?.value ?? '';
                const [hk, nh] = val.includes('|') ? val.split('|') : ['', ''];
                const hkInput = document.querySelector('input[name="hocKy"]');
                const nhInput = document.querySelector('input[name="namHoc"]');
                if (hkInput) hkInput.value = hk;
                if (nhInput) nhInput.value = nh;

                // Fetch đề tài theo học kỳ đã chọn
                updateDeTaiOptions(hk, nh);
            });

            // Initialize display value and load initial topics
            (function initTermDisplay() {
                const input = termEl?.querySelector('input.form-control');
                const hkHidden = document.querySelector('input[name="hocKy"]');
                const nhHidden = document.querySelector('input[name="namHoc"]');
                if (input) {
                    if (hkHidden?.value && nhHidden?.value) {
                        input.value = `HK${hkHidden.value} (${nhHidden.value})`;
                        // Load topics for initial term
                        updateDeTaiOptions(hkHidden.value, nhHidden.value);
                    } else {
                        input.value = '-- Tất cả --';
                        // Load all topics when no term is selected
                        updateDeTaiOptions('', '');
                    }
                }
            })();

            // Status combobox with static options
            const statusEl = document.getElementById('statusDropdownReg');
            const statusDd = new SearchableDropdown('statusDropdownReg', { placeholder: '', searchUrl: null, allowClear: false });
            function getOptionsFromDom(container) {
                const opts = [];
                container.querySelectorAll('.dropdown-options a.dropdown-item').forEach(a => {
                    const v = a.getAttribute('data-value') ?? '';
                    const t = a.textContent ?? '';
                    opts.push({ value: v, text: t });
                });
                return opts;
            }
            statusDd.searchData = async function (query) {
                const all = getOptionsFromDom(statusEl);
                const q = (query || '').toLowerCase();
                const filtered = all.filter(o => !q || o.text.toLowerCase().includes(q) || o.value === q);
                await statusDd.updateOptions(filtered);
            };
            statusDd.searchData('');
            (function initStatusDisplay() {
                const hidden = document.querySelector('input[name="trangThai"]');
                const input = statusEl?.querySelector('input.form-control');
                const currentVal = hidden?.value ?? '';
                const anchor = statusEl.querySelector(`.dropdown-options a.dropdown-item[data-value="${currentVal}"]`);
                if (input) input.value = anchor ? anchor.textContent : '-- Tất cả --';
            })();
            statusEl.addEventListener('selectionChanged', function (e) {
                const val = e?.detail?.value ?? '';
                const input = this.querySelector('input.form-control');
                const hidden = document.querySelector('input[name="trangThai"]');
                if (hidden) hidden.value = val;
                const anchor = this.querySelector(`.dropdown-options a.dropdown-item[data-value="${val}"]`);
                if (input) input.value = anchor ? anchor.textContent : '-- Tất cả --';
            });

            // DeTai combobox with dynamic options
            const deTaiEl = document.getElementById('deTaiDropdownReg');
            const deTaiDd = new SearchableDropdown('deTaiDropdownReg', { placeholder: 'Tìm kiếm đề tài...', searchUrl: null, allowClear: true });

            // Store reference for later use
            deTaiEl.searchableDropdownInstance = deTaiDd;
            // searchData will be set dynamically after loading options from API
            // initDeTaiDisplay will be handled by updateDeTaiOptions after loading from API
            deTaiEl.addEventListener('selectionChanged', function (e) {
                const val = e?.detail?.value ?? '';
                const input = this.querySelector('input.form-control');
                const hidden = document.querySelector('input[name="maDt"]');
                if (hidden) hidden.value = val;
                const anchor = this.querySelector(`.dropdown-options a.dropdown-item[data-value="${val}"]`);
                if (input) input.value = anchor ? anchor.textContent : '-- Tất cả --';
            });

            // Actions delegation
            document.addEventListener('click', function (e) {
                const t = e.target.closest('.btn-approve, .btn-reject, .btn-start, .btn-complete');
                if (!t) return;
                const maSv = t.getAttribute('data-masv');
                const maDt = t.getAttribute('data-madt');
                if (t.classList.contains('btn-approve')) {
                    const f = document.getElementById('frmApprove');
                    f.querySelector('input[name="maSv"]').value = maSv;
                    f.querySelector('input[name="maDt"]').value = maDt;
                    f.submit();
                } else if (t.classList.contains('btn-reject')) {
                    const f = document.getElementById('frmReject');
                    f.querySelector('input[name="maSv"]').value = maSv;
                    f.querySelector('input[name="maDt"]').value = maDt;
                    f.submit();
                } else if (t.classList.contains('btn-start')) {
                    const f = document.getElementById('frmStart');
                    f.querySelector('input[name="maSv"]').value = maSv;
                    f.querySelector('input[name="maDt"]').value = maDt;
                    f.submit();
                } else if (t.classList.contains('btn-complete')) {
                    const hoten = t.getAttribute('data-hoten') || '';
                    const tendt = t.getAttribute('data-tendt') || '';
                    document.getElementById('cmSv').textContent = hoten + ' (#' + maSv + ')';
                    document.getElementById('cmDt').innerHTML = `${tendt} (<span class="text-monospace">${maDt}</span>)`;
                    document.getElementById('cmMaSv').value = maSv;
                    document.getElementById('cmMaDt').value = maDt;
                    const modal = new bootstrap.Modal(document.getElementById('completeModalReg'));
                    modal.show();
                }
            });

        });
    </script>
}
