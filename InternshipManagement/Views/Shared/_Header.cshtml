@* Views/Shared/_Header.cshtml *@
<style>
    /* Responsive header styles */
    @@media (max-width: 991.98px) {
        .navbar-brand {
            font-size: 0.9rem !important;
        }
        
        .navbar-brand img {
            height: 28px !important;
        }
        
        .navbar-brand-text {
            display: none;
        }
    }
    
    @@media (max-width: 576px) {
        .navbar-brand {
            font-size: 0.8rem !important;
        }
        
        .navbar-brand img {
            height: 24px !important;
        }
        
        .nav-link {
            font-size: 0.9rem !important;
        }
        
        .btn {
            font-size: 0.8rem !important;
            padding: 0.4rem 0.8rem !important;
        }
    }
    
    @@media (max-width: 400px) {
        .navbar-brand {
            font-size: 0.75rem !important;
        }
        
        .navbar-brand img {
            height: 20px !important;
        }
        
        .nav-link {
            font-size: 0.8rem !important;
        }
        
        .btn {
            font-size: 0.75rem !important;
            padding: 0.3rem 0.6rem !important;
        }
    }
</style>

<nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
    <div class="container-xxl">
        <a class="navbar-brand fw-semibold d-flex align-items-center" href="/">
            <img src="~/images/logo.png" alt="Logo" class="me-2" style="height: 32px;">
            <span class="navbar-brand-text">Hệ thống quản lý đề tài thực tập</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#topnav"
                aria-controls="topnav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="topnav">
            <ul class="navbar-nav ms-auto mb-2 mb-lg-0">

                @* Khu vực tài khoản *@
                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    var fullName = User.FindFirst("full_name")?.Value ?? User.Identity!.Name;
                    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "User";

                    <li class="nav-item d-flex align-items-center">
                        @{
                            var profileUrl = role switch
                            {
                                "SinhVien" => Url.Action("EditProfile", "SinhVien"),
                                "GiangVien" => Url.Action("EditProfile", "GiangVien"),
                                _ => "#"
                            };
                        }
                        <a href="@profileUrl" class="nav-link d-flex align-items-center">
                            <i class="bi bi-person-circle me-2"></i>
                            <span class="d-none d-md-inline">Xin chào, @fullName (@role)</span>
                            <span class="d-md-none">@fullName</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <form asp-controller="Auth" asp-action="Logout" method="post"
                              class="d-flex align-items-center mb-0">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="btn btn-danger text-white d-flex align-items-center px-3 py-2 ms-lg-2">
                                <i class="bi bi-box-arrow-right me-2"></i>
                                <span class="d-none d-sm-inline">Đăng xuất</span>
                                <span class="d-sm-none">Thoát</span>
                            </button>
                        </form>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link d-flex align-items-center"
                           asp-controller="Auth" asp-action="Login">
                            <i class="bi bi-box-arrow-in-right me-2"></i>
                            Đăng nhập
                        </a>
                    </li>
                }

            </ul>
        </div>
    </div>
</nav>
