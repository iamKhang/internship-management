@model InternshipManagement.Models.ViewModels.ThongKeGiangVienVm
@using System.Text.Json

@{
    ViewData["Title"] = "Thống kê Giảng viên";

    // Serialize an toàn bằng System.Text.Json
    var trendJson = JsonSerializer.Serialize(Model.Trend);
    var statusJson = JsonSerializer.Serialize(Model.StatusDist);
    var fillJson = JsonSerializer.Serialize(Model.DeTaiFill);

    // Tính học kỳ và năm học mặc định
    var now = DateTime.Now;
    var currentYear = now.Year;
    var nextYear = currentYear + 1;
    var currentMonth = now.Month;

    // Xác định học kỳ dựa vào tháng hiện tại
    var currentTerm = currentMonth switch
    {
        >= 9 and <= 12 => 1,  // HK1: 9-12
        >= 1 and <= 4 => 2,   // HK2: 1-4
        _ => 3                 // HK3: 5-8
    };

    // Xác định năm học
    var academicYear = currentTerm == 1
        ? $"{currentYear}-{nextYear}"      // HK1 bắt đầu năm học mới
        : $"{currentYear-1}-{currentYear}"; // HK2,3 thuộc năm học cũ

    // Tính toán ngày mặc định cho kỳ hiện tại
    var termStart = currentTerm switch
    {
        1 => new DateTime(currentYear, 9, 1),    // Sep 1
        2 => new DateTime(currentYear, 1, 1),    // Jan 1
        3 => new DateTime(currentYear, 5, 1),    // May 1
        _ => new DateTime(currentYear, 9, 1)
    };

    var termEnd = currentTerm switch
    {
        1 => new DateTime(currentYear, 12, 31),    // Dec 31
        2 => new DateTime(currentYear, 4, 30),     // Apr 30
        3 => new DateTime(currentYear, 8, 31),     // Aug 31
        _ => new DateTime(currentYear, 12, 31)
    };
}

<!-- FontAwesome CDN -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<div class="container py-3">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h4 class="mb-0 text-primary">
            <i class="fas fa-user-tie me-2"></i>Thống kê của Giảng viên
        </h4>
        <div class="text-muted small">
            Kỳ hiện tại: HK @currentTerm (@academicYear)
        </div>
    </div>

    <!-- Filter Section -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <h6 class="mb-0 d-flex align-items-center">
                <i class="fas fa-filter me-2 text-primary"></i>
                Bộ lọc thống kê
            </h6>
        </div>
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-2">
                    <label class="form-label small fw-semibold">Từ ngày</label>
                    <input type="date" name="from" class="form-control form-control-sm"
                           value="@(Context.Request.Query["from"].FirstOrDefault() ?? termStart.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold">Đến ngày</label>
                    <input type="date" name="to" class="form-control form-control-sm"
                           value="@(Context.Request.Query["to"].FirstOrDefault() ?? termEnd.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold">Năm học</label>
                    <select name="namHoc" class="form-select form-select-sm">
                        <option value="">-- Tất cả năm học --</option>
                        @{
                            for (int y = currentYear - 3; y <= currentYear + 2; y++)
                            {
                                var yearStr = $"{y}-{y+1}";
                                <option value="@yearStr" selected="@(Context.Request.Query["namHoc"].FirstOrDefault() == yearStr)">@yearStr</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold">Học kỳ</label>
                    <select name="hocKy" class="form-select form-select-sm">
                        <option value="">-- Tất cả học kỳ --</option>
                        <option value="1" selected="@(Context.Request.Query["hocKy"].FirstOrDefault() == "1")">Học kỳ 1</option>
                        <option value="2" selected="@(Context.Request.Query["hocKy"].FirstOrDefault() == "2")">Học kỳ 2</option>
                        <option value="3" selected="@(Context.Request.Query["hocKy"].FirstOrDefault() == "3")">Học kỳ 3</option>
                    </select>
                </div>
                <div class="col-4">
                    <div class="d-flex gap-2 justify-content-end">
                        <button class="btn btn-primary btn-sm px-3 py-2" type="submit">
                            <i class="bi bi-funnel me-1"></i>Lọc
                        </button>
                        <a href="@Url.Action("Index", "ThongKe")" class="btn btn-outline-secondary btn-sm px-3 py-2">
                            <i class="bi bi-arrow-clockwise me-1"></i>Xóa lọc
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-2">
            <div class="card border-primary text-center h-100">
                <div class="card-body">
                    <i class="fas fa-file-alt fa-2x text-primary mb-2"></i>
                    <h5 class="card-title">@Model.Kpi.TongDeTai</h5>
                    <p class="card-text text-muted small">Tổng đề tài</p>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card border-info text-center h-100">
                <div class="card-body">
                    <i class="fas fa-user-graduate fa-2x text-info mb-2"></i>
                    <h5 class="card-title">@Model.Kpi.TongSinhVien</h5>
                    <p class="card-text text-muted small">SV đã ĐK</p>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card border-warning text-center h-100">
                <div class="card-body">
                    <i class="fas fa-clock fa-2x text-warning mb-2"></i>
                    <h5 class="card-title">@Model.Kpi.Pending</h5>
                    <p class="card-text text-muted small">Chờ duyệt</p>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card border-primary text-center h-100">
                <div class="card-body">
                    <i class="fas fa-check-circle fa-2x text-primary mb-2"></i>
                    <h5 class="card-title">@Model.Kpi.Accepted</h5>
                    <p class="card-text text-muted small">Đã duyệt</p>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card border-success text-center h-100">
                <div class="card-body">
                    <i class="fas fa-trophy fa-2x text-success mb-2"></i>
                    <h5 class="card-title">@Model.Kpi.Completed</h5>
                    <p class="card-text text-muted small">Hoàn thành</p>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card border-secondary text-center h-100">
                <div class="card-body">
                    <i class="fas fa-calendar-days fa-2x text-secondary mb-2"></i>
                    <h5 class="card-title">@(Model.Kpi.AvgDaysToAccept?.ToString("0.##") ?? "-")</h5>
                    <p class="card-text text-muted small">Avg days accept</p>
                </div>
            </div>
        </div>
    </div>

    <hr class="my-4" />

    <div class="row g-4">
        <div class="col-lg-6">
            <h6 class="mb-2">Xu hướng đăng ký theo tháng</h6>
            <div id="gv_trend" style="height:360px;" class="border rounded"></div>
        </div>
        <div class="col-lg-6">
            <h6 class="mb-2">Phân bố trạng thái</h6>
            <div id="gv_status" style="height:360px;" class="border rounded"></div>
        </div>

        <div class="col-12">
            <h6 class="mb-2">Lấp đầy theo đề tài</h6>
            <div id="gv_fill" style="height:420px;" class="border rounded"></div>
        </div>
    </div>

    @if (!Model.DeTaiFill.Any() && !Model.Trend.Any() && !Model.StatusDist.Any())
    {
        <div class="alert alert-info mt-4">
            Chưa có dữ liệu thống kê cho bộ lọc hiện tại.
        </div>
    }
</div>

@section Scripts {
    <script src="~/lib/echarts/dist/echarts.min.js"></script>
    <script>
        const trendData  = @Html.Raw(trendJson);
        const statusData = @Html.Raw(statusJson);
        const fillData   = @Html.Raw(fillJson);

        // Trend
        (function () {
            const el = document.getElementById('gv_trend');
            const chart = echarts.init(el);
            const xs = trendData.map(p => `${p.Nam}-${String(p.Thang).padStart(2, '0')}`);
            const ys = trendData.map(p => p.SoDangKy);
            chart.setOption({
                tooltip: { trigger: 'axis' },
                xAxis: { type: 'category', data: xs },
                yAxis: { type: 'value' },
                series: [{ type: 'line', data: ys, smooth: true }]
            });
            window.addEventListener('resize', () => chart.resize());
        })();

        // Status
        (function () {
            const el = document.getElementById('gv_status');
            const chart = echarts.init(el);
            const labelMap = { 0: 'Pending', 1: 'Accepted', 2: 'InProgress', 3: 'Completed', 4: 'Rejected', 5: 'Withdrawn' };
            chart.setOption({
                tooltip: { trigger: 'item' },
                legend: { top: 'bottom' },
                series: [{
                    type: 'pie',
                    radius: ['35%', '70%'],
                    data: statusData.map(s => ({ name: labelMap[s.TrangThai] ?? s.TrangThai, value: s.SoLuong }))
                }]
            });
            window.addEventListener('resize', () => chart.resize());
        })();

        // Fill per topic
        (function () {
            const el = document.getElementById('gv_fill');
            const chart = echarts.init(el);
            const names = fillData.map(d => d.TenDt);
            const used = fillData.map(d => d.SlotDaDung);
            const left = fillData.map(d => d.SlotConLai);
            const wait = fillData.map(d => d.DangChoDuyet);
            chart.setOption({
                tooltip: { trigger: 'axis', axisPointer: { type: 'shadow' } },
                grid: { left: 80, right: 20, bottom: 20, containLabel: true },
                xAxis: { type: 'value' },
                yAxis: { type: 'category', data: names },
                series: [
                    { name: 'Đã dùng', type: 'bar', stack: 't', data: used },
                    { name: 'Còn lại', type: 'bar', stack: 't', data: left },
                    { name: 'Chờ duyệt', type: 'bar', stack: 't', data: wait }
                ]
            });
            window.addEventListener('resize', () => chart.resize());
        })();

        // Update date inputs when học kỳ or năm học changes
        const namHocSelect = document.querySelector('select[name="namHoc"]');
        const hocKySelect = document.querySelector('select[name="hocKy"]');
        const fromDateInput = document.querySelector('input[name="from"]');
        const toDateInput = document.querySelector('input[name="to"]');

        function updateDateInputs() {
            const namHoc = namHocSelect.value;
            const hocKy = hocKySelect.value;

            if (namHoc && hocKy) {
                // Parse năm học (format: "2023-2024")
                const [startYear, endYear] = namHoc.split('-').map(y => parseInt(y));

                let termStart, termEnd;

                switch(hocKy) {
                    case '1': // HK1: Sep - Dec of start year
                        termStart = new Date(startYear, 8, 1);    // Sep 1
                        termEnd = new Date(startYear, 11, 31);    // Dec 31
                        break;
                    case '2': // HK2: Jan - Apr of end year
                        termStart = new Date(endYear, 0, 1);      // Jan 1
                        termEnd = new Date(endYear, 3, 30);       // Apr 30
                        break;
                    case '3': // HK3: May - Aug of end year
                        termStart = new Date(endYear, 4, 1);      // May 1
                        termEnd = new Date(endYear, 7, 31);       // Aug 31
                        break;
                    default:
                        return; // Don't update if invalid
                }

                // Update input values
                fromDateInput.value = termStart.toISOString().split('T')[0];
                toDateInput.value = termEnd.toISOString().split('T')[0];
            } else if (namHoc && !hocKy) {
                // Chỉ chọn năm học, không chọn học kỳ cụ thể
                // Gom dữ liệu từ 1/8 của năm đầu tiên đến 31/7 của năm sau
                const [startYear, endYear] = namHoc.split('-').map(y => parseInt(y));

                const termStart = new Date(startYear, 7, 1);      // Aug 1 of start year
                const termEnd = new Date(endYear, 6, 31);         // Jul 31 of end year

                fromDateInput.value = termStart.toISOString().split('T')[0];
                toDateInput.value = termEnd.toISOString().split('T')[0];
            } else if (!namHoc) {
                // Chọn tất cả năm học - reset về kỳ hiện tại mặc định
                const now = new Date();
                const currentYear = now.getFullYear();
                const currentMonth = now.getMonth() + 1; // getMonth() returns 0-11

                let termStart, termEnd;
                if (currentMonth >= 9 && currentMonth <= 12) {
                    // HK1: Sep - Dec
                    termStart = new Date(currentYear, 8, 1);    // Sep 1
                    termEnd = new Date(currentYear, 11, 31);    // Dec 31
                } else if (currentMonth >= 1 && currentMonth <= 4) {
                    // HK2: Jan - Apr
                    termStart = new Date(currentYear, 0, 1);    // Jan 1
                    termEnd = new Date(currentYear, 3, 30);     // Apr 30
                } else {
                    // HK3: May - Aug
                    termStart = new Date(currentYear, 4, 1);    // May 1
                    termEnd = new Date(currentYear, 7, 31);     // Aug 31
                }

                fromDateInput.value = termStart.toISOString().split('T')[0];
                toDateInput.value = termEnd.toISOString().split('T')[0];
            }
        }

        // Function to reset học kỳ and năm học when user manually changes dates
        function resetTermSelectors() {
            namHocSelect.value = '';
            hocKySelect.value = '';
        }

        // Listen for changes
        namHocSelect.addEventListener('change', updateDateInputs);
        hocKySelect.addEventListener('change', updateDateInputs);

        // Reset term selectors when user manually changes dates
        fromDateInput.addEventListener('change', resetTermSelectors);
        toDateInput.addEventListener('change', resetTermSelectors);
    </script>
}
