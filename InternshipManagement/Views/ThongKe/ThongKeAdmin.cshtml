@model InternshipManagement.Models.ViewModels.ThongKeAdminVm
@using System.Text.Json

@{
    ViewData["Title"] = "Thống kê Admin";

    var trendJson = JsonSerializer.Serialize(Model.Trend);
    var statusJson = JsonSerializer.Serialize(Model.StatusDist);
    var fillJson = JsonSerializer.Serialize(Model.DeTaiFill);
    var byKhoaJson = JsonSerializer.Serialize(Model.ByKhoa);
    var topGvJson = JsonSerializer.Serialize(Model.TopGv);
    var termJson = JsonSerializer.Serialize(Model.ByTerm);

    // Tính học kỳ và năm học mặc định
    var now = DateTime.Now;
    var currentYear = now.Year;
    var nextYear = currentYear + 1;
    var currentMonth = now.Month;
    
    // Xác định học kỳ dựa vào tháng hiện tại
    var currentTerm = currentMonth switch
    {
        >= 9 and <= 12 => 1,  // HK1: 9-12
        >= 1 and <= 4 => 2,   // HK2: 1-4
        _ => 3                 // HK3: 5-8
    };

    // Xác định năm học
    var academicYear = currentTerm == 1 
        ? $"{currentYear}-{nextYear}"      // HK1 bắt đầu năm học mới
        : $"{currentYear-1}-{currentYear}"; // HK2,3 thuộc năm học cũ
}

<div class="container py-3">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h4 class="mb-0">Thống kê toàn hệ thống</h4>

        <form method="get" class="row g-2 align-items-center">
            <div class="col-auto"><input type="text" name="maKhoa" class="form-control form-control-sm" placeholder="Mã khoa" /></div>
            <div class="col-auto"><input type="number" name="maGv" class="form-control form-control-sm" placeholder="Mã GV" /></div>
            <div class="col-auto"><input type="date" name="from" class="form-control form-control-sm" /></div>
            <div class="col-auto"><input type="date" name="to" class="form-control form-control-sm" /></div>
            <div class="col-auto">
                <select name="namHoc" class="form-control form-control-sm">
                    <option value="">-- Năm học --</option>
                    @{
                        for (int y = currentYear - 3; y <= currentYear + 2; y++)
                        {
                            var yearStr = $"{y}-{y+1}";
                            <option value="@yearStr" selected="@(yearStr == academicYear)">@yearStr</option>
                        }
                    }
                </select>
            </div>
            <div class="col-auto">
                <select name="hocKy" class="form-control form-control-sm">
                    <option value="">-- Học kỳ --</option>
                    <option value="1" selected="@(currentTerm == 1)">Học kỳ 1</option>
                    <option value="2" selected="@(currentTerm == 2)">Học kỳ 2</option>
                    <option value="3" selected="@(currentTerm == 3)">Học kỳ 3</option>
                </select>
            </div>
            <div class="col-auto"><button class="btn btn-sm btn-primary" type="submit">Lọc</button></div>
        </form>
    </div>

    <div class="row g-3">
        <div class="col-md-2"><div class="card p-3">Đề tài: <b>@Model.Kpi.TongDeTai</b></div></div>
        <div class="col-md-2"><div class="card p-3">Giảng viên: <b>@Model.Kpi.TongGiangVien</b></div></div>
        <div class="col-md-2"><div class="card p-3">Sinh viên: <b>@Model.Kpi.TongSinhVien</b></div></div>
        <div class="col-md-2"><div class="card p-3">Pending: <b>@Model.Kpi.Pending</b></div></div>
        <div class="col-md-2"><div class="card p-3">Accepted: <b>@Model.Kpi.Accepted</b></div></div>
        <div class="col-md-2"><div class="card p-3">Completed: <b>@Model.Kpi.Completed</b></div></div>
    </div>

    <hr class="my-4" />

    <div class="row g-4">
        <div class="col-lg-6">
            <h6 class="mb-2">Xu hướng đăng ký theo tháng</h6>
            <div id="adm_trend" style="height:360px;" class="border rounded"></div>
        </div>
        <div class="col-lg-6">
            <h6 class="mb-2">Phân bố trạng thái</h6>
            <div id="adm_status" style="height:360px;" class="border rounded"></div>
        </div>

        <div class="col-12">
            <h6 class="mb-2">Lấp đầy theo đề tài</h6>
            <div id="adm_fill" style="height:420px;" class="border rounded"></div>
        </div>

        <div class="col-lg-6">
            <h6 class="mb-2">Phân bố theo Khoa</h6>
            <div id="adm_khoa" style="height:360px;" class="border rounded"></div>
        </div>
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 bg-transparent">
                <div class="card-body p-0">
                    <h6 class="mb-3">Top Giảng viên</h6>
                    
                    <!-- Legend tùy biến -->
                    <div class="d-flex flex-wrap gap-3 mb-3 align-items-center" id="legend-top-giangvien">
                        <span class="d-inline-flex align-items-center gap-2">
                            <span class="legend-dot" style="background:#22c55e"></span> Hoàn thành
                        </span>
                        <span class="d-inline-flex align-items-center gap-2">
                            <span class="legend-dot" style="background:#3b82f6"></span> Đang thực hiện
                        </span>
                        <span class="d-inline-flex align-items-center gap-2">
                            <span class="legend-dot" style="background:#f59e0b"></span> Chờ duyệt
                        </span>
                    </div>

                    <!-- Canvas tự co chiều cao -->
                    <div class="position-relative">
                        <canvas id="topGiangVienChart"></canvas>
                    </div>

                    <!-- JSON data -->
                    <script id="top-giangvien-data" type="application/json">
                        @Html.Raw(JsonSerializer.Serialize(Model.TopGv.Select(g => new
                        {
                            name = g.HoTenGv,
                            hoanThanh = g.Completed,
                            dangThucHien = g.DangThucHien,
                            choDuyet = g.Pending
                        })))
                    </script>
                </div>
            </div>
        </div>

        <style>
            .legend-dot {
                width: 14px;
                height: 14px;
                display: inline-block;
                border-radius: 999px;
                box-shadow: 0 0 0 1px rgba(0,0,0,.08) inset;
            }
            #topGiangVienChart {
                max-width: 100%;
            }
        </style>

        <div class="col-12">
            <h6 class="mb-2">Theo Học kỳ / Năm học</h6>
            <div id="adm_term" style="height:360px;" class="border rounded"></div>
        </div>
    </div>

    @if (!Model.Trend.Any() && !Model.StatusDist.Any() && !Model.DeTaiFill.Any() && !Model.ByKhoa.Any() && !Model.TopGv.Any() && !Model.ByTerm.Any())
    {
        <div class="alert alert-info mt-4">Chưa có dữ liệu thống kê cho bộ lọc hiện tại.</div>
    }
</div>

@section Scripts {
    <script src="~/lib/echarts/dist/echarts.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        const trendData  = @Html.Raw(trendJson);
        const statusData = @Html.Raw(statusJson);
        const fillData   = @Html.Raw(fillJson);
        const byKhoaData = @Html.Raw(byKhoaJson);
        const topGvData  = @Html.Raw(topGvJson);
        const termData   = @Html.Raw(termJson);

        // Trend
        (function () {
            const el = document.getElementById('adm_trend');
            const chart = echarts.init(el);
            const xs = trendData.map(p => `${p.Nam}-${String(p.Thang).padStart(2, '0')}`);
            const ys = trendData.map(p => p.SoDangKy);
            chart.setOption({
                tooltip: { trigger: 'axis' },
                xAxis: { type: 'category', data: xs },
                yAxis: { type: 'value' },
                series: [{ type: 'line', data: ys, smooth: true }]
            });
            window.addEventListener('resize', () => chart.resize());
        })();
        // Status
        (function () {
            const el = document.getElementById('adm_status');
            const chart = echarts.init(el);
            const labelMap = { 0: 'Pending', 1: 'Accepted', 2: 'InProgress', 3: 'Completed', 4: 'Rejected', 5: 'Withdrawn' };
            chart.setOption({
                tooltip: { trigger: 'item' },
                legend: { top: 'bottom' },
                series: [{
                    type: 'pie',
                    radius: ['35%', '70%'],
                    data: statusData.map(s => ({ name: labelMap[s.TrangThai] ?? s.TrangThai, value: s.SoLuong }))
                }]
            });
            window.addEventListener('resize', () => chart.resize());
        })();

        // Fill per topic
        (function () {
            const el = document.getElementById('adm_fill');
            const chart = echarts.init(el);
            const names = fillData.map(d => d.TenDt);
            const used  = fillData.map(d => d.SlotDaDung);
            const left  = fillData.map(d => d.SlotConLai);
            const wait  = fillData.map(d => d.DangChoDuyet);
            chart.setOption({
                tooltip: { trigger: 'axis', axisPointer: { type: 'shadow' } },
                grid: { left: 80, right: 20, bottom: 20, containLabel: true },
                xAxis: { type: 'value' },
                yAxis: { type: 'category', data: names },
                series: [
                    { name: 'Đã dùng',   type: 'bar', stack: 'total', data: used },
                    { name: 'Còn lại',   type: 'bar', stack: 'total', data: left },
                    { name: 'Chờ duyệt', type: 'bar', stack: 'total', data: wait }
                ]
            });
            window.addEventListener('resize', () => chart.resize());
        })();

        // By Khoa
        (function () {
            const el = document.getElementById('adm_khoa');
            const chart = echarts.init(el);
            const xs = byKhoaData.map(k => k.MaKhoa);
            const used = byKhoaData.map(k => k.TongSlotDaDung);
            const done = byKhoaData.map(k => k.DaHoanThanh);
            chart.setOption({
                tooltip: { trigger: 'axis' },
                legend: {},
                xAxis: { type: 'category', data: xs },
                yAxis: { type: 'value' },
                series: [
                    { name: 'Slot đã dùng', type: 'bar', data: used },
                    { name: 'Hoàn thành',  type: 'bar', data: done }
                ]
            });
            window.addEventListener('resize', () => chart.resize());
        })();

        // Top GV with Chart.js
        (function() {
            // 1) Lấy dữ liệu
            let raw = (() => {
                try {
                    const el = document.getElementById('top-giangvien-data');
                    return el ? JSON.parse(el.textContent || '[]') : [];
                } catch { return []; }
            })();

            if (!Array.isArray(raw) || raw.length === 0) {
                raw = [
                    { name: "Nguyễn Văn A (Khoa CNTT)", hoanThanh: 5, dangThucHien: 3, choDuyet: 2 },
                    { name: "Trần Thị B (Khoa Cơ khí)", hoanThanh: 4, dangThucHien: 2, choDuyet: 1 },
                    { name: "Lê Văn C (Khoa Kế toán)", hoanThanh: 6, dangThucHien: 1, choDuyet: 0 },
                ];
            }

            // 2) Chuẩn hóa key
            const norm = (item) => ({
                name: item.name || item.ten || item.tenGiangVien || item.tenGV || item.label || "",
                hoanThanh: Number(item.hoanThanh ?? item.HoanThanh ?? item.done ?? 0),
                dangThucHien: Number(item.dangThucHien ?? item.DangThucHien ?? item.inprogress ?? 0),
                choDuyet: Number(item.choDuyet ?? item.ChoDuyet ?? item.pending ?? 0),
            });
            const data = raw.map(norm);

            // 3) Tách label & datasets
            const labels = data.map(x => x.name);
            const dsHoanThanh   = data.map(x => x.hoanThanh);
            const dsDangThucHien= data.map(x => x.dangThucHien);
            const dsChoDuyet    = data.map(x => x.choDuyet);

            // 4) Tự động đặt chiều cao: mỗi hàng ~ 34px
            const perRow = 34;
            const canvas = document.getElementById('topGiangVienChart');
            const desired = Math.max(280, labels.length * perRow + 60);
            canvas.height = desired;

            // 5) Hàm truncate nhãn dài
            function truncateLabel(str, max=28) {
                if (typeof str !== "string") return "";
                return str.length > max ? (str.slice(0, max) + "…") : str;
            }

            // 6) Tạo chart
            new Chart(canvas, {
                type: 'bar',
                data: {
                    labels: labels.map(l => truncateLabel(l)),
                    datasets: [
                        { label: 'Hoàn thành',     data: dsHoanThanh,    backgroundColor: '#22c55e', borderWidth: 0 },
                        { label: 'Đang thực hiện', data: dsDangThucHien, backgroundColor: '#3b82f6', borderWidth: 0 },
                        { label: 'Chờ duyệt',      data: dsChoDuyet,     backgroundColor: '#f59e0b', borderWidth: 0 },
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    indexAxis: 'y',                 // Biểu đồ ngang
                    interaction: { mode: 'nearest', axis: 'y', intersect: false },
                    layout: { padding: { left: 4, right: 8, top: 4, bottom: 4 } },
                    plugins: {
                        legend: {
                            display: false // Legend đã custom bên trên cho gọn
                        },
                        tooltip: {
                            callbacks: {
                                // Hiện tên đầy đủ trong tooltip
                                title: (items) => {
                                    if (!items?.length) return '';
                                    const idx = items[0].dataIndex;
                                    return labels[idx] || '';
                                },
                                label: (item) => {
                                    const dsLabel = item.dataset?.label ?? '';
                                    const v = item.parsed?.x ?? 0;
                                    return ` ${dsLabel}: ${v}`;
                                },
                                footer: (items) => {
                                    if (!items?.length) return '';
                                    const idx = items[0].dataIndex;
                                    const sum = (dsHoanThanh[idx] || 0) + (dsDangThucHien[idx] || 0) + (dsChoDuyet[idx] || 0);
                                    return `Tổng: ${sum}`;
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            stacked: true,
                            ticks: {
                                autoSkip: false,
                                maxRotation: 0,
                                minRotation: 0,
                                font: { size: 12 }
                            },
                            grid: { display: false }
                        },
                        x: {
                            stacked: true,
                            ticks: {
                                precision: 0,
                                stepSize: 1
                            },
                            grid: { color: 'rgba(0,0,0,0.06)' }
                        }
                    }
                }
            });
        })();

        // By Term
        (function () {
            const el = document.getElementById('adm_term');
            const chart = echarts.init(el);
            const xs = termData.map(t => `${t.NamHoc}-HK${t.HocKy}`);
            const used = termData.map(t => t.SlotDaDung);
            const done = termData.map(t => t.HoanThanh);
            const wait = termData.map(t => t.ChoDuyet);
            chart.setOption({
                tooltip: { trigger: 'axis', axisPointer: { type: 'shadow' } },
                xAxis: { type: 'category', data: xs },
                yAxis: { type: 'value' },
                series: [
                    { name: 'Đã dùng',   type: 'bar', stack: 't', data: used },
                    { name: 'Hoàn thành',type: 'bar', stack: 't', data: done },
                    { name: 'Chờ duyệt', type: 'bar', stack: 't', data: wait }
                ]
            });
            window.addEventListener('resize', () => chart.resize());
        })();
    </script>
}
